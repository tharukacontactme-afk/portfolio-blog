# Public site URL for Open Graph / LinkedIn previews (no trailing slash)
# Example: https://yourname.github.io/portfolio-blog
VITE_SITE_URL=

# Contact form → your Gmail (via Web3Forms, free for static sites)
#
# 1. Open https://web3forms.com
# 2. Enter your Gmail (e.g. tharuka.contactme@gmail.com) and create an Access Key
# 3. Verify the confirmation email from Web3Forms
# 4. Copy the key into a new file named .env.local (same folder as package.json):
#      VITE_WEB3FORMS_ACCESS_KEY=your-access-key-here
# 5. Restart: npm run dev
#
# For production (GitHub Pages, Netlify, Vercel, etc.), set the same variable
# in your host's environment / secrets before running npm run build.
VITE_WEB3FORMS_ACCESS_KEY=
